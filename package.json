{
  "name": "invest",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "assets:one": "node scripts/copy-one-assets.cjs",
    "assets:compile": "mag-cli assets --config ./mag-cli.config.js; code=$?; npm run assets:one; exit $code",
    "assets:watch": "mag-cli assets --config ./mag-cli.config.js --watch",
    "gen:code": "mag-cli gen-code",
    "gen:test": "mag-cli gen-test",
    "prestart": "npm run gen:code && npm run assets:compile",
    "start": "ng serve",
    "prebuild": "npm run gen:code && npm run assets:compile",
    "build": "ng build",
    "prebuild:wc": "npm run gen:code",
    "build:wc": "mag-cli assets-wc --config ./mag-cli.config.js; npm run assets:one; mag-cli patch-wc-env",
    "pretest": "npm run gen:test",
    "test": "ng test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@angular/animations": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/elements": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@magmonium/one": "0.4.55",
    "@ngrx/signals": "^22.0.1",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular-builders/custom-webpack": "^22.0.0",
    "@magmonium/cli": "0.8.18",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "angular-eslint": "^22.0.0",
    "typescript-eslint": "^8.71.0",
    "eslint-config-prettier": "^10.1.8",
    "sass": "^1.69.5",
    "typescript": "6.0.3",
    "vitest": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^27.1.0",
    "webpack": "5.110.3"
  },
  "overrides": {
    "webpack": "5.110.3",
    "@angular-devkit/build-angular": "22.2.1"
  }
}
