        "f7e0b9b5-584d-41e5-91b7-6a7b7ddc4217": {
          "aiDrafted": true,
          "body": "rankingMap[id] = response;\n  return rankingMap;",
          "cases": [
            {
              "args": [
                "[{ \"symbol\": \"AAPL\", \"w\": 1, \"m\": 2, \"q\": 3, \"h\": 4, \"y\": 5, \"y2\": 6, \"score\": 7 }]",
                "{}",
                "\"AAPL\""
              ],
              "expected": "{ \"AAPL\": [{ \"symbol\": \"AAPL\", \"w\": 1, \"m\": 2, \"q\": 3, \"h\": 4, \"y\": 5, \"y2\": 6, \"score\": 7 }] }",
              "name": "assigns response to a new id"
            },
            {
              "args": [
                "[{ \"symbol\": \"AAPL\", \"w\": 1, \"m\": 2, \"q\": 3, \"h\": 4, \"y\": 5, \"y2\": 6, \"score\": 7 }]",
                "{ \"MSFT\": [{ \"symbol\": \"MSFT\", \"w\": 8, \"m\": 9, \"q\": 10, \"h\": 11, \"y\": 12, \"y2\": 13, \"score\": 14 }] }",
                "\"AAPL\""
              ],
              "expected": "{ \"MSFT\": [{ \"symbol\": \"MSFT\", \"w\": 8, \"m\": 9, \"q\": 10, \"h\": 11, \"y\": 12, \"y2\": 13, \"score\": 14 }], \"AAPL\": [{ \"symbol\": \"AAPL\", \"w\": 1, \"m\": 2, \"q\": 3, \"h\": 4, \"y\": 5, \"y2\": 6, \"score\": 7 }] }",
              "name": "preserves existing entries"
            },
            {
              "args": [
                "[]",
                "{ \"A\": [] }",
                "\"B\""
              ],
              "expected": "{ \"A\": [], \"B\": [] }",
              "name": "stores an empty response array"
            },
            {
              "args": [
                "[{ \"symbol\": \"NEW\", \"w\": 0, \"m\": 0, \"q\": 0, \"h\": 0, \"y\": 0, \"y2\": 0, \"score\": 0 }]",
                "{ \"id\": [{ \"symbol\": \"OLD\", \"w\": 1, \"m\": 1, \"q\": 1, \"h\": 1, \"y\": 1, \"y2\": 1, \"score\": 1 }] }",
                "\"id\""
              ],
              "expected": "{ \"id\": [{ \"symbol\": \"NEW\", \"w\": 0, \"m\": 0, \"q\": 0, \"h\": 0, \"y\": 0, \"y2\": 0, \"score\": 0 }] }",
              "name": "overwrites an existing key"
            }
          ],
