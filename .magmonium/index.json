  "features": {
    "acef9153-606d-4de2-8699-7c87fa589384": {
      "computeds": {},
      "functions": {
        "94ec0572-4d3a-41b7-91c7-a313d4e13c8b": {
          "aiDrafted": true,
          "body": "const COLUMNS = ['symbol', 'w', 'm', 'q', 'h', 'y', 'y2', 'score'] as const;\n  const NUMERIC = ['w', 'm', 'q', 'h', 'y', 'y2', 'score'] as const;\n\n  const raw = rankingMap[id] as unknown;\n  if (!Array.isArray(raw)) return undefined;\n  if (raw.length === 0) return [];\n\n  const entries = raw.map((row) =>\n    Array.isArray(row)\n      ? Object.fromEntries(COLUMNS.map((key, i) => [key, row[i]]))\n      : row\n  ) as Record<string, unknown>[];\n\n  const stats = Object.fromEntries(\n    NUMERIC.map((key) => {\n      const values = entries.map((e) => Number(e[key])).filter(Number.isFinite);\n      const min = values.length ? Math.min(...values) : 0;\n      const max = values.length ? Math.max(...values) : 0;\n      return [key, { min, max }];\n    })\n  ) as Record<string, { min: number; max: number }>;\n\n  return entries.map((entry) => {\n    const next = { ...entry } as Record<string, unknown>;\n    for (const key of NUMERIC) {\n      const { min, max } = stats[key];\n      const v = Number(entry[key]);\n      next[key] = !Number.isFinite(v) ? NaN : max === min ? 0 : ((v - min) / (max - min)) * 100;\n    }\n    return next as unknown as FinanceRankingUpdateResponse;\n  });",
          "cases": [
            {
              "args": [
                "\"missing\"",
                "{}"
              ],
              "expected": "undefined",
              "name": "returns undefined for missing id"
            },
            {
              "args": [
                "\"empty\"",
                "{ \"empty\": [] }"
              ],
              "expected": "[]",
              "name": "returns empty array for empty entries"
            },
            {
              "args": [
                "\"AAA\"",
                "{ \"AAA\": [{ \"symbol\": \"A\", \"w\": 0, \"m\": 5, \"q\": 10, \"h\": 2, \"y\": 4, \"y2\": 8, \"score\": 1 }, { \"symbol\": \"B\", \"w\": 10, \"m\": 5, \"q\": 20, \"h\": 8, \"y\": 4, \"y2\": 8, \"score\": 3 }] }"
              ],
              "expected": "[{ \"symbol\": \"A\", \"w\": 0, \"m\": 0, \"q\": 0, \"h\": 0, \"y\": 0, \"y2\": 0, \"score\": 0 }, { \"symbol\": \"B\", \"w\": 100, \"m\": 0, \"q\": 100, \"h\": 100, \"y\": 0, \"y2\": 0, \"score\": 100 }]",
              "name": "normalizes numeric columns to percentages"
            },
            {
              "args": [
                "\"X\"",
                "{ \"X\": [{ \"symbol\": \"X\", \"w\": 7, \"m\": 7, \"q\": 7, \"h\": 7, \"y\": 7, \"y2\": 7, \"score\": 7 }] }"
              ],
              "expected": "[{ \"symbol\": \"X\", \"w\": 0, \"m\": 0, \"q\": 0, \"h\": 0, \"y\": 0, \"y2\": 0, \"score\": 0 }]",
              "name": "keeps symbol unchanged"
            },
            {
              "args": [
                "\"C\"",
                "{ \"C\": [{ \"symbol\": \"A\", \"w\": 5, \"m\": 5, \"q\": 5, \"h\": 5, \"y\": 5, \"y2\": 5, \"score\": 5 }, { \"symbol\": \"B\", \"w\": 5, \"m\": 5, \"q\": 5, \"h\": 5, \"y\": 5, \"y2\": 5, \"score\": 5 }] }"
              ],
              "expected": "[{ \"symbol\": \"A\", \"w\": 0, \"m\": 0, \"q\": 0, \"h\": 0, \"y\": 0, \"y2\": 0, \"score\": 0 }, { \"symbol\": \"B\", \"w\": 0, \"m\": 0, \"q\": 0, \"h\": 0, \"y\": 0, \"y2\": 0, \"score\": 0 }]",
              "name": "constant values normalize to zero"
            }
          ],
          "description": "Returns the ranking entries stored under the given id, with numeric fields (all except the symbol column) normalized to percentage values using column-wise min/max scaling.",
          "id": "94ec0572-4d3a-41b7-91c7-a313d4e13c8b",
          "name": "ranking",
          "params": [
